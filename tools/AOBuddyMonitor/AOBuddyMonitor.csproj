<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AOBuddyMonitor</AssemblyName>
    <RootNamespace>AOBuddyMonitor</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- The exe's own icon (Explorer, taskbar pin); the window sets the same one for its title bar and taskbar button. -->
    <ApplicationIcon>Assets/aobuddy-monitor.ico</ApplicationIcon>
    <!-- The owner's monitoring GUI for the running bot (2026-09-26): a dashboard over the bot's local
         control API (BotApi: /status /nav /log /inventory, POST /command) plus a map that renders the
         bot's own nav data. Thick client ON PURPOSE: it links the bot project (AOBuddy20.csproj), so the
         terrain on screen is computed by the same NavGround/AOBuddyNav code the bot walks on — the
         picture cannot drift from the bot's logic (the ported NavData.cs carries the rooms.json floor
         stamping and the wall handling the pathfinding uses). net10.0 is inherited from the root props.
         Avalonia is the only new dependency (OS-agnostic UI). -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.*" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/aobuddy-monitor.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\AOBuddy20\AOBuddy20.csproj" />
  </ItemGroup>
</Project>
