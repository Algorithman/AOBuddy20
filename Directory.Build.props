<Project>
  <!--
    AOBuddy10 — shared build settings for the .NET 10 migration.
    The whole solution targets net10.0-windows (Windows-only runtime; the Unmanaged/Imports
    P/Invoke in AOSharp.Common compiles here but is never called by the clientless bot).
    GenerateAssemblyInfo is off so each project keeps its existing Properties/AssemblyInfo.cs
    (preserves AOSharp.Common's Version=1.0.0.0 that references expect).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!-- CA1416 = Windows-only API (P/Invoke never called clientless); CS0618/CS0612 = obsolete APIs. -->
    <NoWarn>$(NoWarn);CA1416;CS0618;CS0612;CS1591;NU1701</NoWarn>
  </PropertyGroup>

  <!--
    ONE place to find everything a run needs. The whole solution builds into Build/ at the
    repository root:

        Build/                     the host, the SDK assemblies, and the clientless config.json
        Build/Plugins/AOBuddy/     AOBuddy.dll, its GameData, and its own config.json

    Before this, the host looked for its config beside Test/bin/Debug/Test.exe, and that config
    named the plugin by an ABSOLUTE path into a different project's bin/Debug — so a fresh clone,
    or a moved repository, meant hunting down two files in two places and editing a hard-coded
    path. The host now resolves plugin paths relative to itself and finds Plugins/ on its own.

    Debug and Release share the folder deliberately: the two configs you edit live in it, and
    having to set them up twice was half the problem. Projects under tools/ opt out, in
    tools/Directory.Build.props — they are one-off extractors, not part of a run.
  -->
  <PropertyGroup>
    <BuildRoot>$(MSBuildThisFileDirectory)Build\</BuildRoot>
    <OutputPath>$(BuildRoot)</OutputPath>
  </PropertyGroup>
</Project>
